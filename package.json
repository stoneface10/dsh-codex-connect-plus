{
  "name": "dsh-codex-connect-plus",
  "displayName": "Codex Connect Plus",
  "description": "Use your ChatGPT subscription in DeepSeek Harness to access Codex models and generate or edit images with gpt-image-2—no OpenAI Platform API key required.",
  "version": "0.1.0-beta.5",
  "author": "0751",
  "contributors": [
    {
      "name": "Frank Song",
      "url": "https://github.com/franksong2702/dsh-codex-connect"
    },
    {
      "name": "Yan-Zero",
      "url": "https://github.com/Yan-Zero/dsh-codex"
    },
    {
      "name": "JuneLearn",
      "url": "https://github.com/JuneLearn/dsh-image2-draw"
    },
    {
      "name": "ningzimu",
      "url": "https://github.com/ningzimu/codex-gpt-image"
    },
    {
      "name": "dsh-multimodal contributors",
      "url": "https://github.com/MC5lan/dsh-multimodal"
    }
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openai-codex",
    "chatgpt-oauth",
    "oauth",
    "codex",
    "gpt-image-2",
    "image-generation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoneface10/dsh-codex-connect-plus.git"
  },
  "homepage": "https://github.com/stoneface10/dsh-codex-connect-plus#readme",
  "bugs": {
    "url": "https://github.com/stoneface10/dsh-codex-connect-plus/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-codex-connect-plus": "lib/bin.js"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "build": "tsdown",
    "test": "cross-env NODE_ENV=test vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "client:check": "node scripts/check-client-bundle.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run client:check && pnpm run test && pnpm run pack:check",
    "prepublishOnly": "pnpm --config.minimum-release-age=0 run check"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "INSTALL.md",
    "MIGRATION.md",
    "RELEASING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
